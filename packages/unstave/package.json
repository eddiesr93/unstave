{
  "name": "@unstave/node",
  "version": "0.2.0",
  "description": "Native module-graph analysis for TypeScript and React workspaces",
  "keywords": [
    "typescript",
    "module-graph",
    "dependency-graph",
    "barrel-files",
    "codemod",
    "monorepo",
    "static-analysis",
    "build-performance",
    "rust",
    "napi-rs"
  ],
  "license": "MIT",
  "repository": "github:eddiesr93/unstave",
  "homepage": "https://eddiesr93.github.io/unstave/",
  "bugs": {
    "url": "https://github.com/eddiesr93/unstave/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../crates/unstave-napi/Cargo.toml --output-dir . --no-js --dts native.d.ts",
    "artifacts": "napi artifacts --npm-dir npm",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test test/*.test.js",
    "typecheck": "node --check index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.2"
  },
  "napi": {
    "binaryName": "unstave",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  }
}
