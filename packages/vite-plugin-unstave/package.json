{
  "name": "@unstave/vite-plugin",
  "version": "0.2.0",
  "description": "Non-blocking unstave module-graph reports for Vite",
  "keywords": [
    "vite",
    "vite-plugin",
    "typescript",
    "module-graph",
    "dependency-graph",
    "barrel-files",
    "codemod",
    "monorepo",
    "static-analysis",
    "build-performance"
  ],
  "type": "module",
  "license": "MIT",
  "repository": "github:eddiesr93/unstave",
  "homepage": "https://eddiesr93.github.io/unstave/",
  "bugs": {
    "url": "https://github.com/eddiesr93/unstave/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@unstave/node": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
